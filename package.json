{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check --write .",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "lint-staged": {
    "*": "biome check --write --error-on-warnings --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.2.2"
}
